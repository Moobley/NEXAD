# NEXAD — public environment variables (not secrets)

# Public Formspree Form ID used by the Contact page form.
# Create a form at https://formspree.io, copy its ID (e.g. "xaybzqwa") and set
# it here. The ID is public — it ships in the page bundle — so configure it as
# a GitHub repository *variable* (not a secret) for both workflows.
# The real recipient inbox is nexadlab@gmail.com; it is configured inside the
# Formspree dashboard, never in this repository or in the frontend.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Contact form feature flag. The form is OFF by default (pre-launch) and only
# becomes submittable when this is "true" AND NEXT_PUBLIC_FORMSPREE_FORM_ID is
# set. Production activation stays blocked until the Legal/Contact production
# prerequisites (TODO 6B) are complete — keep this OFF until then.
# Anti-spam for the first release is the "_gotcha" honeypot already implemented
# in the form; no CAPTCHA is added. Re-evaluate anti-spam measures only if real
# spam requires it.
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false

# Static-export base path. Empty locally, for production (Aruba) and for the
# next.config basePath; set to /NEXAD only for the GitHub Pages preview build
# (injected by the deploy workflow).
NEXT_PUBLIC_BASE_PATH=

# Public site origin (scheme + host, WITHOUT the basePath).
# - GitHub Pages preview (temporary, pre-launch, noindex):
#   https://moobley.github.io with NEXT_PUBLIC_BASE_PATH=/NEXAD
# - Canonical production origin: https://www.nexadlab.com (empty basePath),
#   hosted as a static export on Aruba via FTPS (deploy-aruba.yml).
#   An indexable build (NEXT_PUBLIC_SITE_INDEXABLE=true) is allowed ONLY on
#   this origin with an empty basePath — the build fails otherwise.
# - Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Site indexability. The GitHub Pages preview AND the first Aruba production
# deployment must stay "false" (pre-launch noindex). Only set to "true" at the
# explicit go-live step, with NEXT_PUBLIC_SITE_ORIGIN=https://www.nexadlab.com
# and an empty basePath.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Optional: Google Ads ID (e.g. "AW-123456789") for Google Consent Mode.
# Leave empty to keep Google Ads fully disabled. Public value — it ships in
# the client bundle. The gtag.js script is only loaded AFTER the user grants
# advertising consent.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Optional: Meta Pixel ID (e.g. "1234567890123456"). Leave empty to keep Meta
# Pixel fully disabled. Public value — it ships in the client bundle. The pixel
# is only initialized AFTER the user grants advertising consent.
NEXT_PUBLIC_META_PIXEL_ID=

# ----------------------------------------------------------------------------
# GitHub repository variables (Settings → Secrets and variables → Actions)
# ----------------------------------------------------------------------------
# The Aruba production workflow (deploy-aruba.yml) reads these at build/deploy
# time. They are NOT part of .env.local and are not used by local development.
# Recommended values for the first (pre-go-live) Aruba deployment:
#   NEXT_PUBLIC_SITE_INDEXABLE=false
#   NEXT_PUBLIC_CONTACT_FORM_ENABLED=false
#   NEXT_PUBLIC_FORMSPREE_FORM_ID=<your Formspree form ID>
#   ARUBA_FTP_SERVER=<FTP host from the Aruba hosting panel>
#   ARUBA_FTP_PORT=21              (Aruba FTPS = explicit TLS on port 21)
#   ARUBA_FTP_PROTOCOL=ftps        (ftp / ftps / ftps-legacy)
#   ARUBA_FTP_SERVER_DIR=/httpdocs/   (depends on the plan; must end with /)
# Credentials are GitHub Actions SECRETS, never variables:
#   ARUBA_FTP_USERNAME, ARUBA_FTP_PASSWORD